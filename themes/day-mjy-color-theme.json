    "widget.border": "#E5E5E5",
    "surface.border": "#E5E5E5",
    "agentsPanel.border": "#E5E5E5",
    "modernActivityBar.activeBackground": "#e4e6f1",
    "modernActivityBar.hoverBackground": "#F2F2F2",
    "modernActivityBar.activeForeground": "#3B3B3B",
    "modernActivityBar.hoverForeground": "#3B3B3B"
  },
  "tokenColors": [
    {
      "name": "Comments",
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#6F7973",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Keywords and storage",
      "scope": [
        "keyword",
        "storage",
        "storage.type",
        "storage.modifier"
      ],
      "settings": {
        "foreground": "#16756F"
      }
    },
    {
      "name": "Constants and numbers",
      "scope": [
        "constant",
        "constant.numeric",
        "variable.language"
      ],
      "settings": {
        "foreground": "#7651B5"
      }
    },
    {
      "name": "Language constants",
      "scope": [
        "constant.language",
        "constant.language.python",
        "constant.language.java"
      ],
      "settings": {
        "foreground": "#6F58A8"
      }
    },
    {
      "name": "Strings",
      "scope": [
        "string",
        "string.quoted",
        "string.template"
      ],
      "settings": {
        "foreground": "#297454"
      }
    },
    {
      "name": "RegExp",
      "scope": [
        "string.regexp",
        "constant.regexp"
      ],
      "settings": {
        "foreground": "#297454"
      }
    },
    {
      "name": "Functions",
      "scope": [
        "entity.name.function",
        "support.function",
        "meta.function-call"
      ],
      "settings": {
        "foreground": "#167493"
      }
    },
    {
      "name": "Types and classes",
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "support.type",
        "support.class"
      ],
      "settings": {
        "foreground": "#365F9D"
      }
    },
    {
      "name": "Tags and attributes",
      "scope": [
        "entity.name.tag",
        "entity.other.attribute-name"
      ],
      "settings": {
        "foreground": "#87558F"
      }
    },
    {
      "name": "HTML and XML tags",
      "scope": [
        "entity.name.tag.html",
        "entity.name.tag.xml",
        "text.html.basic entity.name.tag",
        "meta.tag entity.name.tag"
      ],
      "settings": {
        "foreground": "#167493"
      }
    },
    {
      "name": "Variables and properties",
      "scope": [
        "variable",
        "variable.other",
        "meta.object-literal.key",
        "support.variable"
      ],
      "settings": {
        "foreground": "#343943"
      }
    },
    {
      "name": "Operators",
      "scope": [
        "keyword.operator",
        "punctuation"
      ],
      "settings": {
        "foreground": "#4E5661"
      }
    },
    {
      "name": "Markup headings",
      "scope": [
        "markup.heading",
        "markup.bold"
      ],
      "settings": {
        "foreground": "#167493",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markup emphasis",
      "scope": [
        "markup.italic",
        "markup.quote"
      ],
      "settings": {
        "foreground": "#87558F",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Markup links",
      "scope": [
        "markup.underline.link",
        "string.other.link"
      ],
      "settings": {
        "foreground": "#297454",
        "fontStyle": "underline"
      }
    },
    {
      "name": "Invalid",
      "scope": [
        "invalid",
        "invalid.illegal"
      ],
      "settings": {
        "foreground": "#A33A58",
        "fontStyle": "underline"
      }
    },
    {
      "name": "Annotations and decorators",
      "scope": [
        "meta.annotation",
        "meta.decorator",
        "punctuation.definition.annotation",
        "storage.type.annotation",
        "entity.name.type.annotation",
        "entity.name.function.decorator",
        "entity.name.function.decorator.python"
      ],
      "settings": {
        "foreground": "#87558F"
      }
    },
    {
      "name": "Java modifiers",
      "scope": [
        "storage.modifier.java",
        "storage.modifier.access.java",
        "keyword.modifier.java"
      ],
      "settings": {
        "foreground": "#3E817C"
      }
    },
    {
      "name": "Java primitive and reference types",
      "scope": [
        "storage.type.primitive.java",
        "storage.type.java",
        "entity.name.type.java"
      ],
      "settings": {
        "foreground": "#365F9D"
      }
    },
    {
      "name": "Java control flow",
      "scope": [
        "keyword.control.conditional.java",
        "keyword.control.switch.java",
        "keyword.control.loop.java",
        "keyword.control.java"
      ],
      "settings": {
        "foreground": "#16756F"
      }
    },
    {
      "name": "Java return and flow exit",
      "scope": [
        "keyword.control.return.java",
        "keyword.control.break.java",
        "keyword.control.continue.java",
        "keyword.control.throw.java"
      ],
      "settings": {
        "foreground": "#16756F"
      }
    }
  ],
  "semanticHighlighting": true,
  "semanticTokenColors": {
    "comment": "#6F7973",
    "string": "#297454",
    "number": "#7651B5",
    "keyword": "#16756F",
    "modifier": "#3E817C",
    "operator": "#4E5661",
    "function": "#167493",
    "method": "#167493",
    "class": "#365F9D",
    "interface": "#365F9D",
    "enum": "#365F9D",
    "type": "#365F9D",
    "typeParameter": "#365F9D",
    "parameter": "#343943",
    "variable": "#343943",
    "property": "#3F4853",
    "enumMember": "#7651B5",
    "boolean": "#6F58A8",
    "null": "#6F58A8",
    "namespace": "#365F9D",
    "decorator": "#87558F",
    "label": "#555D68",
    "regexp": "#297454"
  }
}
