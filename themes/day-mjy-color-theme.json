{
  "$schema": "vscode://schemas/color-theme",
  "name": "Day (MJY)",
  "type": "light",
  "colors": {
    "foreground": "#1F2937",
    "descriptionForeground": "#526174",
    "focusBorder": "#008FB8",
    "errorForeground": "#A9324A",
    "widget.shadow": "#1F293726",
    "window.activeBorder": "#D7E1EA",
    "window.inactiveBorder": "#E7EDF3",
    "button.background": "#006B4F",
    "button.foreground": "#FFFFFF",
    "button.hoverBackground": "#005541",
    "button.secondaryBackground": "#E7EDF3",
    "button.secondaryForeground": "#1F2937",
    "dropdown.background": "#FFFFFF",
    "dropdown.foreground": "#1F2937",
    "dropdown.border": "#C7D3DF",
    "input.background": "#F8FAFC",
    "input.foreground": "#1F2937",
    "input.border": "#C7D3DF",
    "input.placeholderForeground": "#66708599",
    "list.activeSelectionBackground": "#DDF5ED",
    "list.activeSelectionForeground": "#123B35",
    "list.focusBackground": "#EAF8F3",
    "list.hoverBackground": "#F1F6F8",
    "list.inactiveSelectionBackground": "#EAF8F3",
    "list.highlightForeground": "#007A59",
    "activityBar.background": "#F5F8FA",
    "activityBar.foreground": "#1F2937",
    "activityBar.inactiveForeground": "#66708599",
    "activityBar.activeBorder": "#008FB8",
    "activityBar.activeBackground": "#EAF1F5",
    "sideBar.background": "#F5F8FA",
    "sideBar.foreground": "#344054",
    "sideBarTitle.foreground": "#1F2937",
    "sideBarSectionHeader.background": "#EAF1F5",
    "sideBarSectionHeader.foreground": "#344054",
    "editorGroupHeader.tabsBackground": "#F5F8FA",
    "editorGroupHeader.noTabsBackground": "#FFFFFF",
    "editorGroup.border": "#D7E1EA",
    "tab.activeBackground": "#FFFFFF",
    "tab.activeForeground": "#1F2937",
    "tab.inactiveBackground": "#F5F8FA",
    "tab.inactiveForeground": "#667085",
    "tab.hoverBackground": "#EAF1F5",
    "tab.border": "#D7E1EA",
    "tab.activeBorderTop": "#008EAE",
    "editor.background": "#FFFFFF",
    "editor.foreground": "#1F2937",
    "editorCursor.foreground": "#008FB8",
    "editorLineNumber.foreground": "#7A8696",
    "editorLineNumber.activeForeground": "#344054",
    "editor.lineHighlightBackground": "#F5F8FA",
    "editor.selectionBackground": "#CDEFE3",
    "editor.selectionForeground": "#123B35",
    "editor.inactiveSelectionBackground": "#EAF8F3",
    "editorIndentGuide.background1": "#E7EDF3",
    "editorIndentGuide.activeBackground1": "#B9C7D5",
    "editorBracketHighlight.foreground1": "#007EA7",
    "editorBracketHighlight.foreground2": "#008FB8",
    "editorBracketHighlight.foreground3": "#006B8F",
    "editorBracketHighlight.foreground4": "#2E75A8",
    "editorBracketHighlight.foreground5": "#3B82A0",
    "editorBracketHighlight.foreground6": "#4F6FAE",
    "minimap.background": "#F5F8FA",
    "panel.background": "#F5F8FA",
    "panel.border": "#D7E1EA",
    "statusBar.background": "#EAF1F5",
    "statusBar.foreground": "#344054",
    "titleBar.activeBackground": "#F5F8FA",
    "titleBar.activeForeground": "#1F2937",
    "titleBar.inactiveBackground": "#F5F8FA",
    "titleBar.inactiveForeground": "#667085",
    "terminal.background": "#FFFFFF",
    "terminal.foreground": "#1F2937",
    "terminalCursor.foreground": "#008EAE",
    "terminal.selectionBackground": "#CDEFE3",
    "editorWidget.background": "#FFFFFF",
    "editorWidget.border": "#C7D3DF",
    "notifications.background": "#FFFFFF",
    "notifications.foreground": "#1F2937",
    "editorSuggestWidget.background": "#FFFFFF",
    "editorSuggestWidget.foreground": "#1F2937",
    "editorSuggestWidget.selectedBackground": "#EAF8F3",
    "quickInput.background": "#FFFFFF",
    "quickInput.foreground": "#1F2937",
    "quickInputList.focusBackground": "#EAF8F3",
    "scrollbarSlider.background": "#98A2B366",
    "scrollbarSlider.hoverBackground": "#66708566",
    "scrollbarSlider.activeBackground": "#52617499"
  },
  "tokenColors": [
    {"name": "Comments", "scope": ["comment", "punctuation.definition.comment"], "settings": {"foreground": "#667085", "fontStyle": "italic"}},
    {"name": "Keywords and storage", "scope": ["keyword", "storage", "storage.type", "storage.modifier"], "settings": {"foreground": "#0A8F68"}},
    {"name": "Constants and numbers", "scope": ["constant", "constant.numeric", "constant.language", "variable.language"], "settings": {"foreground": "#9A4D00"}},
    {"name": "Strings", "scope": ["string", "string.quoted", "string.template"], "settings": {"foreground": "#006B4F"}},
    {"name": "RegExp", "scope": ["string.regexp", "constant.regexp"], "settings": {"foreground": "#006B5A"}},
    {"name": "Functions", "scope": ["entity.name.function", "support.function", "meta.function-call"], "settings": {"foreground": "#007EA7"}},
    {"name": "Types and classes", "scope": ["entity.name.type", "entity.name.class", "support.type", "support.class"], "settings": {"foreground": "#4F46B5"}},
    {"name": "Tags and attributes", "scope": ["entity.name.tag", "entity.other.attribute-name"], "settings": {"foreground": "#A31D5F"}},
    {"name": "HTML and XML tags", "scope": ["entity.name.tag.html", "entity.name.tag.xml", "text.html.basic entity.name.tag", "meta.tag entity.name.tag"], "settings": {"foreground": "#007EA7"}},
    {"name": "Variables and properties", "scope": ["variable", "variable.other", "meta.object-literal.key", "support.variable"], "settings": {"foreground": "#1F2937"}},
    {"name": "Operators", "scope": ["keyword.operator", "punctuation"], "settings": {"foreground": "#526174"}},
    {"name": "Markup headings", "scope": ["markup.heading", "markup.bold"], "settings": {"foreground": "#007EA7", "fontStyle": "bold"}},
    {"name": "Markup emphasis", "scope": ["markup.italic", "markup.quote"], "settings": {"foreground": "#8C1F55", "fontStyle": "italic"}},
    {"name": "Markup links", "scope": ["markup.underline.link", "string.other.link"], "settings": {"foreground": "#006B5A", "fontStyle": "underline"}},
    {"name": "Invalid", "scope": ["invalid", "invalid.illegal"], "settings": {"foreground": "#A9324A", "fontStyle": "underline"}},
    {"name": "Annotations and decorators", "scope": ["meta.annotation", "punctuation.definition.annotation", "storage.type.annotation", "entity.name.type.annotation", "entity.name.function.decorator"], "settings": {"foreground": "#4F46B5"}}
  ],
  "semanticHighlighting": true,
  "semanticTokenColors": {
    "comment": "#667085",
    "string": "#006B4F",
    "number": "#9A4D00",
    "keyword": "#0A8F68",
    "operator": "#465365",
    "function": "#007EA7",
    "method": "#008FB8",
    "class": "#4F46B5",
    "interface": "#4F46B5",
    "type": "#4F46B5",
    "typeParameter": "#6D28D9",
    "parameter": "#1F2937",
    "variable": "#1F2937",
    "property": "#075985",
    "enumMember": "#007A59",
    "namespace": "#4F46B5",
    "decorator": "#4F46B5",
    "label": "#006B5A",
    "regexp": "#006B5A"
  }
}
